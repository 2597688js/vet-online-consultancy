# Optional. Copy to backend/.env only if you need to change something.

# Default: the backend starts its own Postgres server on port 5433 with the data in the project's db/ folder,
# connecting as your OS user. Point this anywhere else to use another Postgres server instead.
# DATABASE_URL=postgresql+psycopg://localhost:5433/vet_online_consultancy

# Generated automatically on first run.
# JWT_SECRET=

# The doctor's email: receives appointment reminder emails.
# DOCTOR_EMAIL=

# "Continue with Google" sign-in (also set VITE_GOOGLE_CLIENT_ID in .env.local at the project root).
# GOOGLE_CLIENT_ID=

# Email notifications to the doctor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
