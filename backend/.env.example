# Optional. Copy to backend/.env only if you need to change something.

# Default: local Postgres as your OS user. Change if your Postgres needs a user/password.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vet_online_consultancy

# Generated automatically on first run.
# JWT_SECRET=

# "Continue with Google" sign-in (also set VITE_GOOGLE_CLIENT_ID in .env.local at the project root).
# GOOGLE_CLIENT_ID=

# Email notifications to the doctor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
